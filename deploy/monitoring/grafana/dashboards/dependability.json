{
 "title": "University IS - dependability",
 "uid": "univ-is",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-10m",
  "to": "now"
 },
 "tags": [
  "fault-tolerance"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Instances healthy",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(target_up)",
     "legendFormat": "healthy",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": []
    },
    "overrides": []
   },
   "options": {},
   "description": "Replicas passing the monitor's readiness check (0.5 s polling)."
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Instances down",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "count(target_up) - sum(target_up)",
     "legendFormat": "down",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "User-visible success ratio (15s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "1 - ((sum(rate(http_requests_total{service=\"gateway\",code=~\"5..\"}[15s])) or vector(0)) / sum(rate(http_requests_total{service=\"gateway\"}[15s])))",
     "legendFormat": "success",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {},
   "description": "Share of requests answered by the gateways without a 5xx (= measured availability)."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Writes queued in journal",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "max(db_journal_pending) or vector(0)",
     "legendFormat": "pending",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {},
   "description": "Store-and-forward outbox: writes accepted with HTTP 202 while the primary DB is down."
  },
  {
   "id": 5,
   "type": "state-timeline",
   "title": "Health checks per instance (monitor, 0.5 s polling)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "expr": "target_up",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "UP",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "DOWN",
         "color": "red",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Request rate by instance (req/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (instance) (rate(http_requests_total[15s]))",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Failed requests (5xx/s) by instance",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(http_requests_total{code=~\"5..\"}[15s])) or vector(0)",
     "legendFormat": "all instances",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "sum by (instance) (rate(http_requests_total{code=~\"5..\"}[15s]))",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Mean latency by instance",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (instance) (rate(http_request_duration_seconds_sum[15s])) / sum by (instance) (rate(http_request_duration_seconds_count[15s]))",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Faults masked by the gateway (events/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(gateway_retries_total[15s]))",
     "legendFormat": "retry on another replica",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "sum(rate(gateway_stale_total[15s]))",
     "legendFormat": "stale-cache answer (degraded)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
    },
    {
     "expr": "sum(rate(gateway_shed_total[15s]))",
     "legendFormat": "load shed (priority)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C"
    },
    {
     "expr": "sum(rate(gateway_failed_total[15s]))",
     "legendFormat": "not masked -> 503",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "D"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {},
   "description": "Retries with backoff, graceful degradation and load shedding as they happen."
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Circuit breakers open",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "(sum(gateway_circuit_open) + sum(db_circuit_open)) or vector(0)",
     "legendFormat": "open breakers (total)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "sum by (target) (gateway_circuit_open) > 0",
     "legendFormat": "gateway -> {{target}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
    },
    {
     "expr": "max by (instance) (db_circuit_open) > 0",
     "legendFormat": "{{instance}} -> primary DB",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": []
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Database: primary availability, replica failover, journal",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 29,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "min(db_primary_available)",
     "legendFormat": "primary available (min over services)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "sum(rate(db_replica_reads_total[15s]))",
     "legendFormat": "reads served by replica /s",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
    },
    {
     "expr": "max(db_journal_pending)",
     "legendFormat": "journal pending",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C"
    },
    {
     "expr": "sum(rate(db_journal_replayed_total[15s]))",
     "legendFormat": "journal replayed /s",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "D"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": []
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "primary available (min over services)"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 1
       },
       {
        "id": "custom.lineWidth",
        "value": 3
       }
      ]
     }
    ]
   },
   "options": {}
  }
 ]
}